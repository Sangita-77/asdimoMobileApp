# Google OAuth client IDs from Google Cloud Console.
# The Android client ID must also be included in the backend GOOGLE_CLIENT_IDS value,
# otherwise verifyIdToken() will reject the ID token.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=486198135019-j0tajm0rvc2db9g1q6nflt8hnllh0ams.apps.googleusercontent.com

# Facebook App ID (not the App Secret). Configure this value in your local .env
# and rebuild the native app after adding Facebook Login settings in Meta.
EXPO_PUBLIC_FACEBOOK_APP_ID=1083657204087096
