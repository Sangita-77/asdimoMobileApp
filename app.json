{
  "expo": {
    "name": "ASDimo",
    "slug": "asdimo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "asdimo",
      "fb1083657204087096",
      "com.swatibazal.asdimo",
      "com.googleusercontent.apps.486198135019-91n0mqg6h1s3rrdn2ac4ksnreo1quej1"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.swatibazal.asdimo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.swatibazal.asdimo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-asset",
      "expo-screen-orientation",
      "expo-image",
      "expo-status-bar",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "553bda55-3652-4838-9372-2208871337e8"
      }
    }
  }
}
